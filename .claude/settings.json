{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f bughunter/tools/bootstrap_arsenal.sh ] && bash bughunter/tools/bootstrap_arsenal.sh > /tmp/arsenal_bootstrap.log 2>&1 || true",
            "timeout": 300,
            "async": true
          },
          {
            "type": "command",
            "command": "[ -f bughunter/tools/bootstrap_plugins.sh ] && bash bughunter/tools/bootstrap_plugins.sh > /tmp/plugin_bootstrap.log 2>&1 || true",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f tools/memory_gc.py ] && python3 -m tools.memory_gc --rotate >/dev/null 2>&1 || true",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "cybersecurity-skills@anthropic-cybersecurity-skills": true
  },
  "extraKnownMarketplaces": {
    "anthropic-cybersecurity-skills": {
      "source": {
        "source": "github",
        "repo": "mukul975/Anthropic-Cybersecurity-Skills"
      }
    }
  }
}
